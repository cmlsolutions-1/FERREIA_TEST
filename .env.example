NODE_ENV=development
POSTGRES_DB=ferreia
POSTGRES_USER=ferreia_user
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ferreia_user:change_me_before_running@localhost:5432/ferreia?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000
ADMIN_EMAIL=admin@ferreia.co
ADMIN_PASSWORD=change_me_admin_password

GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=FERREIA

SPACES_BUCKET=your-bucket
SPACES_KEY=your-spaces-key
SPACES_SECRET=your-spaces-secret
SPACES_URL_CDN=https://your-bucket.nyc3.cdn.digitaloceanspaces.com
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# IA local con Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=320
